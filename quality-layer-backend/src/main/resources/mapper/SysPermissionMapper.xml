<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.quality.mapper.SysPermissionMapper">
    <resultMap id="PermResult" type="SysPermission">
        <id column="id" property="id"/>
        <result column="label" property="label"/>
        <result column="parent_id" property="parentId"/>
        <result column="type" property="type"/>
    </resultMap>
    <select id="selectAll" resultMap="PermResult">
        SELECT * FROM sys_permission ORDER BY parent_id,id
    </select>
    <select id="selectById" resultMap="PermResult">
        SELECT * FROM sys_permission WHERE id = #{id}
    </select>
    <select id="selectByParentId" resultMap="PermResult">
        SELECT * FROM sys_permission WHERE parent_id = #{parentId}
    </select>
</mapper>